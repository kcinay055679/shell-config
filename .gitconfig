[user]
	name = Yanick Minder
	email = minder@puzzle.ch
	signingkey = 6DD3216D9EAB9F24
	
[alias]      
	#simple git aliases                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
	co = checkout                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
	coo = !git fetch && git checkout                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
	ci = commit  
	st = status                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
	br = branch    
	aa = add -A                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
	aaa = !git aa && git amend                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
	au = add -u                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
	cm = commit -m      
	amend = commit --amend --no-edit                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     

  # worktree related stuff
  wt = worktree
  wta = "!git worktree add ../$(git root-dir)-$1"                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
  # wta = "!echo \"../$(git root-dir)-$1 \""



	# related to czg https://cz-git.qbb.sh/cli/                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
	acc = "!!g add && g cc "                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
	accr = "!!g add && g ccr "                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
	ccc = "!czg --retry && git commit --amend"       
	cc = czg                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
	ccr = !git ra && czg --retry                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
  
  # git hisotry commands
  hist = log --oneline --graph --decorate
  lola = log --oneline --graph --decorate --all
  lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cblue<%an>%Creset' --abbrev-commit 
  lga = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s  %Cblue<%an>%Creset' --abbrev-commit --date=relative --all

	# git simplified workflow aliases
	ra = "!git diff --name-only --cached | xargs -l git add" # readd all files that are already staged    
	wip = !git aa && git cm "wip" --no-verify       
	nowip = "!f() { msg=$(git log -1 --pretty=%s); if [ \"$msg\" = \"wip\" ]; then git reset --soft HEAD~1; else echo \"The last commit is not a wip commit\"; fi; }; f"                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
	cood = "!f() { git fetch $1 && git br -D $1 git co $1}; f" # checkout remote branch and delete local branch if it exists     
	squashBranch = !git reset $(git merge-base $(git rev-parse --abbrev-ref origin/HEAD) $(git pwd))                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
	lock = update-index --skip-worktree                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
	unlock = update-index --no-skip-worktree                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
	pullf = !git fetch && git reset --hard $(git pwd-origin)      
	runCheck = !git stash && git commit --allow-empty -m 'Trigger workflow' && git push && git stash pop                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
	clear = !git restore --worktree --staged .                  
	set-latest-date = "!f() { GIT_COMMITTER_DATE=\"$1\" git commit --date=\"$1\" --amend --no-edit --allow-empty; }; f"    
	pfusch = push --force-with-lease                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
	prune-branches = !git fetch -p && git branch -vv | grep \": gone]\" | cut -d \" \" -f 1 | xargs git branch -D                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
	brn = "!f() { old_name=$(git branch --show-current); git branch -m \"$1\" && git push origin -u \"$1\" && git push origin --delete \"$old_name\"; }; f"                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              
	bbrn = "!f() { git branch -m \"$1\" \"$2\" && git push origin -u \"$2\" && git push origin --delete \"$1\"; }; f"                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
	
	# custom command related to parent branch
  root = rev-parse --show-toplevel
  root-dir = "!f() { basename $(git root); }; f"
	cob = "!f() { c=$(git pwd); git checkout -b \"$1\" && git set-parent \"$c\"; }; f"
	cop = "!git checkout $(git parent)"
	parent = "!git config --get \"branch.$(git pwd).parent\" || true" 
	set-parent = "!f() { git config \"branch.$(git pwd).parent\" \"$1\"; }; f"
	set-parent-latest = "!git set-parent $(git rev-parse --abbrev-ref @{-1})"
	set-parent-default = "!git set-parent $(git br-default)"
	srb = "!f() { \
	      parent=$(git parent); \
	      default=$(git br-default); \
	      if [ \"$parent\" = \"$default\" ]; then \
	          git fetch origin \"$parent\" && git rebase \"origin/$parent\"; \
	      else \
	          printf 'Rebase on origin/%s? [Y/n] ' \"$parent\"; \
	          read -r ans; \
	          case \"$ans\" in \
	              ''|y|Y|yes|YES) git fetch origin \"$parent\" && git rebase \"origin/$parent\" ;; \
	              *) exit 1 ;; \
	          esac; \
	      fi; \
	  }; f"

	# git custom aliases rename
	sb = squashBranch                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
	p = parent
	pl = set-parent-latest
	pd = set-parent-default
  rb=rebase

	# git utilities (is extracted to simplify other aliases)
	pwd = "rev-parse --abbrev-ref HEAD"     
	pwd-origin = rev-parse --abbrev-ref --symbolic-full-name @{u}                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
	alias = ! git config --get-regexp ^alias\\. | sed -e s/^alias\\.// -e s/\\ /\\ =\\ / # shows all aliases         
	br-default = "!git rev-parse --abbrev-ref origin/HEAD"
	rebase-onto = "!f() { git rebase --onto \"${1:?newbase}\" \"${2:?upstream}\" \"${3:-HEAD}\"; }; f"
	rebase-replayed = "!f() { u=\"${1:?upstream}\"; b=\"${2:-HEAD}\"; base=$(git merge-base --fork-point \"$u\" \"$b\" 2>/dev/null || git merge-base \"$u\" \"$b\"); echo \"cutoff: $(git rev-parse --short \"$base\")\"; git log --oneline \"$base..$b\"; }; f"
	resquash = "!f() { nb=\"${1:?newbase}\"; u=\"${2:?upstream}\"; b=\"${3:-HEAD}\"; git rebase-replayed \"$u\" \"$b\" || exit 1; printf \"rebase %s onto %s? [y/N] \" \"$b\" \"$nb\"; read a; case \"$a\" in [yY]*) git rebase --onto \"$nb\" --fork-point \"$u\" \"$b\";; *) echo aborted; exit 1;; esac; }; f"
  rebase-squashed = "!f() { def=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed \"s@^origin/@@\"); cur=$(git pwd 2>/dev/null || git branch --show-current); up=$(git p 2>/dev/null); printf \"rebase onto (newbase) [%s]: \" \"$def\"; read -r nb; nb=\"${nb:-$def}\"; printf \"upstream / exclusion cutoff [%s]: \" \"$up\"; read -r u; u=\"${u:-$up}\"; printf \"branch to rebase [%s]: \" \"$cur\"; read -r b; b=\"${b:-$cur}\"; [ -n \"$nb\" ] || { echo \"newbase required\"; exit 1; }; [ -n \"$u\" ] || { echo \"upstream required\"; exit 1; }; base=$(git merge-base --fork-point \"$u\" \"$b\" 2>/dev/null || git merge-base \"$u\" \"$b\"); echo; echo \"cutoff: $(git rev-parse --short \"$base\")\"; echo \"will replay onto $nb:\"; git log --oneline \"$base..$b\"; echo; printf \"run: git rebase --onto %s --fork-point %s %s ? [y/N] \" \"$nb\" \"$u\" \"$b\"; read -r a; case \"$a\" in [yY]*) git rebase --onto \"$nb\" --fork-point \"$u\" \"$b\";; *) echo aborted; exit 1;; esac; }; f"
	                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
[core]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
	autocrlf = input                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
	excludesFile = ~/.gitignore                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
	pager = diff-so-fancy | less --tabs=4 -RF                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
	hooksPath =~/.githooks                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               
	rerere=true                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
[init]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
	defaultBranch = main                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
[diff]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
	tool = idea                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
[difftool "idea"]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
	cmd = idea diff $LOCAL $REMOTE                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
[merge]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
	tool = idea                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
[mergetool "idea"]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
	cmd = idea merge $LOCAL $REMOTE $BASE $MERGED                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
	trustExitCode = true                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               
[difftool "mymeld"]
        cmd = meld $LOCAL $REMOTE
[mergetool "mymeld"]
        cmd = meld $LOCAL $BASE $REMOTE --output=$MERGED --auto-merge
[mergetool "mymeld3"]
        cmd = meld $LOCAL $BASE $REMOTE --output=$MERGED --diff $BASE $LOCAL --diff $BASE $REMOTE --auto-merge
[mergetool]
        prompt = false
        keepBackups = false
        keepTemporaries = false
[interactive]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          
	diffFilter = diff-so-fancy --patch                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                   
[color]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
	ui = true                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
[color "diff-highlight"]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               
	oldNormal = red bold                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
	oldHighlight = red bold 52                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           
	newNormal = green bold                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               
	newHighlight = green bold 22                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
[color "diff"]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                         
	meta = 11                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            
	frag = magenta bold                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
	func = 146 bold                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      
	commit = yellow bold                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
	old = red bold                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
	new = green bold                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
	whitespace = red reverse                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
[push]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
	autoSetupRemote = true                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               
	default = simple                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
	                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     
[pull]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
	rebase = true                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
[commit]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               
	gpgsign = true                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
[tag]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
	gpgSign = true                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                       
[safe]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                 
	directory = /home/yminder/projects/simap                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             
	directory = /home/yminder/projects/agentic_coding/pitc_risk_example_project
[rerere]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               
	autoupdate = true                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    
[rebase]
	autosquash = true
